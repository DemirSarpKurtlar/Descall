#include <winver.h>
1 ICON "descall.ico"
1 24 "setup.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 4,0,0,0
PRODUCTVERSION 4,0,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Descall"
      VALUE "FileDescription", "Descall Setup"
      VALUE "FileVersion", "4.0.0.0"
      VALUE "InternalName", "Descall-Setup"
      VALUE "LegalCopyright", "Copyright (c) 2026 Demir Sarp Kurtlar"
      VALUE "OriginalFilename", "Descall-Setup.exe"
      VALUE "ProductName", "Descall"
      VALUE "ProductVersion", "4.0.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END

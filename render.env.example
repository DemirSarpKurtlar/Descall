# Descall — Render Environment Variables
# Dashboard → des-call → Environment → Add from .env
# veya: node scripts/setup-render-env.mjs
#
# Supabase: Dashboard → Project Settings → API
# https://supabase.com/dashboard/project/_/settings/api

# Zorunlu — Supabase
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key...

# Zorunlu — Auth (Render Blueprint otomatik üretebilir)
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_EXPIRES_IN=7d

# Otomatik (render.yaml'da tanımlı, genelde değiştirmene gerek yok)
VITE_API_BASE_URL=https://des-call.onrender.com
PORT=3000
NODE_VERSION=20
ALLOW_ALL_ORIGINS=true

# Opsiyonel — Server voice SFU (eksikse mesh WebRTC kullanılır)
LIVEKIT_URL=wss://your-livekit-host
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# iOS Capacitor push (APNs device tokens). Android keeps using FCM above.
# Auth key from Apple Developer → Keys → Apple Push Notifications service (.p8).
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_PRIVATE_KEY=
# APNS_BUNDLE_ID=com.descall.app
# APNS_USE_SANDBOX=true

# Riot rank lookup (confirm on Render; same as previous Vercel backend secret)
# HENRIK_API_KEY=

# --- Valorant Companion / Riot Sign-On (Adım 2) ---
# REQUIRED for primary Companion login (auth.riotgames.com).
# Create client at https://developer.riotgames.com/ — do not invent values.
# Redirect URI must match exactly.
# RIOT_CLIENT_ID=
# RIOT_CLIENT_SECRET=
# RIOT_REDIRECT_URI=https://des-call.onrender.com/api/riot/oauth/callback
# Optional Riot account API:
# RIOT_API_KEY=          # account-v1 + Adım 5/6 missions+store/loadout gate (Companion)

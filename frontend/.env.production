# Public, build-time Vite vars for Vercel / production static builds.
# Backend secrets stay on Render — do NOT put service-role keys here.
# Browser SPA on descall.com must call the Render API (not same-origin /api).
# Set the same values in the Vercel dashboard (Production + Preview):
#   VITE_API_BASE_URL=https://des-call.onrender.com
#   VITE_SOCKET_URL=https://des-call.onrender.com
# These are public origins, not secrets. Never put SUPABASE_SERVICE_ROLE_KEY / JWT_SECRET in VITE_*.
VITE_API_BASE_URL=https://des-call.onrender.com
VITE_SOCKET_URL=https://des-call.onrender.com

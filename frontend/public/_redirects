# Cloudflare Pages redirects (descall.com). vercel.json is only used on Vercel.
# DimaAI was removed in 2.9.141: old links go home.
/dimaai / 301
/dimaai/* / 301

# No /api/* rule here: Pages cannot proxy to an external origin (it served the
# SPA HTML instead). The apps call https://des-call.onrender.com directly.

# Netlify-style host redirects. Keep in sync: www → apex, and force HTTPS apex.
http://www.descall.com/* https://descall.com/:splat 301!
https://www.descall.com/* https://descall.com/:splat 301!
http://descall.com/* https://descall.com/:splat 301!

# Signed-in app routes stay the SPA (200). Everything else that is not a
# real file is a 404. Cloudflare serves existing files before these rules.

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Descall app privacy manifest. Keep in sync with the App Store Connect privacy label
     (appstore-listing/privacy-labels.md). Everything is linked to the account, nothing is tracking.
     EmailAddress / Name / UserID: account (Name = display name/username); email, username and user id
     are also sent to PostHog identify (product analytics, no session replay). CoarseLocation: signup
     country from the edge IP-country header + PostHog GeoIP. DeviceID: APNs push tokens, the PostHog
     anonymous id and the first-party analytics visitor key. EmailsOrTextMessages / OtherUserContent:
     messages, server/channel content, profile text, reactions, block list, LFG lobbies.
     PhotosorVideos: avatars, banners, attachments. AudioData: voice messages the user sends only
     (calls are never recorded). CustomerSupport: in-app feedback and user reports.
     ProductInteraction / OtherUsageData: PostHog + first-party analytics events, presence.
     CrashData: Sentry + PostHog exceptions. PerformanceData: web vitals to PostHog.
     OtherDiagnosticData: session user agent/IP, device/OS/app version. OtherDataTypes = birth date
     (age gate). No tracking, no tracking domains. -->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeEmailAddress</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>

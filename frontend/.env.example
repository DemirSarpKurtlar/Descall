# === Frontend (Vite) ===
VITE_API_BASE_URL=https://des-call.onrender.com
VITE_SOCKET_URL=https://des-call.onrender.com
# Yerel geliştirme:
# VITE_API_BASE_URL=http://localhost:3000
# VITE_SOCKET_URL=http://localhost:3000

# PostHog product analytics (Descall EU project)
# Dashboard → Project settings → Project API key (phc_…)
# Production builds embed the public key via .env.production (or PROD fallback).
# Local/dev: leave empty to disable, or paste the same phc_ key to test.
VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# Optional HTML meta verification (injected at build only if set).
# GSC: skip VITE_GSC_VERIFICATION when the Domain property is already DNS-verified.
# Use it only for a separate URL-prefix property that chose HTML-tag verification.
# VITE_GSC_VERIFICATION=
# Bing Webmaster HTML tag (optional):
# VITE_BING_SITE_VERIFICATION=
# Optional:
# VITE_GA_MEASUREMENT_ID=
# VITE_CLARITY_ID=
# Google Ads (defaults baked into analytics.js):
#   tag AW-439578855 + Kaydolma label OLLZCM7ZmuEcEOfhzdEB
# VITE_GOOGLE_ADS_ID=AW-439578855
# VITE_GOOGLE_ADS_SIGNUP_LABEL=OLLZCM7ZmuEcEOfhzdEB

# Google Sign-In (OAuth 2.0 / Google Identity Services)
# Create a Web client in Google Cloud Console → APIs & Services → Credentials
# Authorized JavaScript origins must include every SPA host:
#   http://localhost:5173, https://descall.com, https://www.descall.com,
#   https://descall.vercel.app, https://des-call.onrender.com
VITE_GOOGLE_CLIENT_ID=
# Backend can also read GOOGLE_CLIENT_ID (preferred in production secrets)
# GOOGLE_CLIENT_ID=

# Frontend optional WebRTC override (JSON array):
# VITE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]

# === Backend (frontend/backend — yerel çalıştırma) ===
# Supabase: Dashboard → Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...service-role-key-not-anon...

JWT_SECRET=local-dev-secret-min-32-characters-long
JWT_EXPIRES_IN=7d
PORT=3000

# DimaAI — optional bootstrap keys (preferred: Admin → DimaAI). Server-side only.
# GEMINI_API_KEY=
# GEMINI_API_KEY_1=
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=
# DIMA_KEY_ENCRYPTION_SECRET=

# Web Push / VAPID for installed PWAs (required for iOS background call alerts).
# Generate values with: npx web-push generate-vapid-keys
# WEB_PUSH_SUBJECT=mailto:admin@example.com
# WEB_PUSH_PUBLIC_KEY=...
# WEB_PUSH_PRIVATE_KEY=...
# VITE_WEB_PUSH_PUBLIC_KEY=... # Same value as WEB_PUSH_PUBLIC_KEY

# WebRTC TURN (optional — improves NAT/VPN connectivity)
# TURN_URL=turn:your.turn.server:3478?transport=udp
# TURN_USERNAME=...
# TURN_CREDENTIAL=...
# Or full JSON array:
# ICE_SERVERS_JSON=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:...","username":"...","credential":"..."}]

# LiveKit SFU (preferred for server voice when all three are set)
# LIVEKIT_URL=wss://your-livekit-host
# LIVEKIT_API_KEY=...
# LIVEKIT_API_SECRET=...
# LIVEKIT_FORCE=1  # refuse mesh fallback when SFU is expected in production
#
# Firebase Cloud Messaging (Android Capacitor + optional web FCM)
# Paste the full service-account JSON as a single line:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# === Riot / Valorant account linking ===
# REQUIRED for real competitive rank after Name#TAG link:
# Free key: https://api.henrikdev.xyz/dashboard/ (or Henrik Discord #get-a-key)
HENRIK_API_KEY=
# Official Riot Account API (optional verify):
# RIOT_API_KEY=
# Full "Sign in with Riot" (RSO) — requires Riot production approval:
# RIOT_CLIENT_ID=
# RIOT_CLIENT_SECRET=
# RIOT_REDIRECT_URI=https://descall.com/api/riot/oauth/callback
# PUBLIC_APP_URL=https://descall.com
# SITE_URL=https://descall.com
#
# === Vercel (SPA only) ===
# Root Directory: frontend
# Build: npm run build:prod  |  Output: dist
# Set the same VITE_* keys above in Vercel Project → Settings → Environment Variables
# (Production + Preview). Backend secrets stay on Render — never put
# SUPABASE_SERVICE_ROLE_KEY / JWT_SECRET / WEB_PUSH_PRIVATE_KEY on Vercel.

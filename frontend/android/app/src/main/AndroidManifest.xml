<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/AppTheme">

        <!-- FCM messages without a known channel land here, not in "Miscellaneous".
             The channels themselves are created in src/lib/nativePush.js
             (ensureAndroidPushChannels: descall_default, incoming_calls). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="descall_default" />

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density|fontScale|fontWeightAdjustment"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">

            <!-- adjustResize: the window is never panned for the keyboard. Capacitor's
                 SystemBars insets listener pads the decor view by the IME inset and the
                 web app follows the visual viewport (src/lib/mobileViewport.js); with the
                 old unspecified mode a pan could stack on top of that and the whole page
                 jumped up.
                 fontScale / fontWeightAdjust are handled in place: the WebView text zoom
                 is fixed (MainActivity), and recreating the activity for a system font
                 size or bold-text change reloaded the whole web app (and dropped a call). -->

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Android App Links for invite URLs. Verified against
                 https://descall.com/.well-known/assetlinks.json (template and steps:
                 docs/play-store/README.md). Only the apex host: www.descall.com
                 301-redirects, and a redirecting host can never verify. The URL is
                 routed in JS (DescallDeepLinkPlugin.java -> src/lib/nativeDeepLinks.js). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="descall.com" />
                <data android:pathPrefix="/servers/join/" />
                <data android:pathPrefix="/invite/" />
                <data android:pathPrefix="/i/" />
                <data android:pathPrefix="/s/" />
            </intent-filter>

            <!-- descall:// custom scheme, same routes as the iOS app (src/lib/deepLinks.js). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="descall" />
            </intent-filter>

            <!-- 4.2: long press on the app icon (Android 7.1+) and Google Assistant App Actions. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />

        </activity>

        <!-- 4.2: invisible trampoline for launcher shortcuts. A launcher clears the target's
             task; this activity takes that in its own task and brings the running app forward
             (DescallShortcutActivity.java), so a call or the open chat survives. -->
        <activity
            android:name=".DescallShortcutActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- 4.3 "Paylaş > Descall": share target (any app's share sheet and Direct Share, the
             <share-target> in res/xml/shortcuts.xml). Hosts the web share sheet (/share); the
             send runs in share/ShareWorker (WorkManager), so closing the sheet never stops it. -->
        <activity
            android:name=".DescallShareActivity"
            android:exported="true"
            android:label="@string/share_title"
            android:theme="@style/AppTheme.NoActionBar"
            android:excludeFromRecents="true"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density|fontScale|fontWeightAdjustment"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/*" />
                <data android:mimeType="audio/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="application/*" />
                <data android:mimeType="audio/*" />
            </intent-filter>
        </activity>

        <!-- Share notification buttons: Durdur, Gizle, Geri al, Tekrar dene, Gönder (draft). -->
        <receiver
            android:name=".share.ShareActionReceiver"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Home screen widgets (draft B "Yuzler", com.descall.app.widget): online friends,
             unread messages, who is in voice and the live call, each 2x2 / 4x2 / 4x4.
             Providers are exported for the launcher (APPWIDGET_UPDATE is a protected
             broadcast only the system sends); everything else is private. -->
        <receiver
            android:name=".widget.FriendsWidgetProvider"
            android:exported="true"
            android:label="@string/widget_friends_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_friends_info" />
        </receiver>

        <receiver
            android:name=".widget.UnreadWidgetProvider"
            android:exported="true"
            android:label="@string/widget_unread_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_unread_info" />
        </receiver>

        <receiver
            android:name=".widget.VoiceWidgetProvider"
            android:exported="true"
            android:label="@string/widget_voice_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_voice_info" />
        </receiver>

        <receiver
            android:name=".widget.CallWidgetProvider"
            android:exported="true"
            android:label="@string/widget_call_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_call_info" />
        </receiver>

        <!-- Widget taps that do not open the app (refresh, wave, call mute / sound / leave):
             only our own PendingIntents reach it. -->
        <receiver
            android:name=".widget.WidgetActionReceiver"
            android:exported="false" />

        <!-- Invisible trampoline for widget taps that open the app (a chat, Join), like
             DescallShortcutActivity: forwards to the running MainActivity and finishes. -->
        <activity
            android:name=".widget.WidgetLaunchActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Widget settings: favorite faces, switches, colour, servers. Exported so the
             launcher can start it with APPWIDGET_CONFIGURE when a widget is placed / edited. -->
        <activity
            android:name=".widget.WidgetConfigActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/cfg_title_widget"
            android:taskAffinity=""
            android:theme="@style/WidgetConfigTheme">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <service
            android:name=".CallForegroundService"
            android:exported="false"
            android:foregroundServiceType="microphone|mediaPlayback" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Only the foreground service types CallForegroundService really starts with
         (microphone|mediaPlayback). Google Play asks for a declaration and a video
         for every type, so unused FOREGROUND_SERVICE_CAMERA / _MEDIA_PROJECTION
         and USE_FULL_SCREEN_INTENT (nothing posts a full-screen intent; Play
         restricts it to calling/alarm apps that do) are not declared. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Bluetooth headset mic/speaker routing in the WebView's WebRTC stack on
         Android 11 and lower (install-time permission). Android 12+ needs the
         runtime BLUETOOTH_CONNECT permission, which the app does not request yet. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <!-- Android 16 Live Updates: the ongoing call notification asks to be promoted (status bar
         chip, top of the shade). A normal permission; ignored before Android 16. -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />
</manifest>

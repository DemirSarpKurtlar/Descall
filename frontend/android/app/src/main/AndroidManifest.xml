<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Android App Links for invite URLs. Verified against
                 https://descall.com/.well-known/assetlinks.json (template and steps:
                 docs/play-store/README.md). Only the apex host: www.descall.com
                 301-redirects, and a redirecting host can never verify. The URL is
                 routed in JS (DescallDeepLinkPlugin.java -> src/lib/nativeDeepLinks.js). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="descall.com" />
                <data android:pathPrefix="/servers/join/" />
                <data android:pathPrefix="/invite/" />
                <data android:pathPrefix="/i/" />
                <data android:pathPrefix="/s/" />
            </intent-filter>

            <!-- descall:// custom scheme, same routes as the iOS app (src/lib/deepLinks.js). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="descall" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <service
            android:name=".CallForegroundService"
            android:exported="false"
            android:foregroundServiceType="microphone|mediaPlayback" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Only the foreground service types CallForegroundService really starts with
         (microphone|mediaPlayback). Google Play asks for a declaration and a video
         for every type, so unused FOREGROUND_SERVICE_CAMERA / _MEDIA_PROJECTION
         and USE_FULL_SCREEN_INTENT (nothing posts a full-screen intent; Play
         restricts it to calling/alarm apps that do) are not declared. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Bluetooth headset mic/speaker routing in the WebView's WebRTC stack on
         Android 11 and lower (install-time permission). Android 12+ needs the
         runtime BLUETOOTH_CONNECT permission, which the app does not request yet. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />
</manifest>

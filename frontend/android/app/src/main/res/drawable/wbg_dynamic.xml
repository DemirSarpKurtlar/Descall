<?xml version="1.0" encoding="utf-8"?>
<!-- Widget surface, Material You (system palette on Android 12+, colors in values-v31 / values-night-v31). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/w_radius" />
            <gradient
                android:angle="270"
                android:endColor="@color/wdyn_bg_end"
                android:startColor="@color/wdyn_bg_start"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/w_radius" />
            <gradient
                android:centerX="0"
                android:centerY="0"
                android:endColor="#00000000"
                android:gradientRadius="@dimen/w_glow_radius"
                android:startColor="@color/wdyn_glow"
                android:type="radial" />
        </shape>
    </item>
</layer-list>

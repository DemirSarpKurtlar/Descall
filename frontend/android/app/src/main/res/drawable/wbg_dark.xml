<?xml version="1.0" encoding="utf-8"?>
<!-- Widget surface, Descall dark (draft B: radial accent glow top left over #3F4256 to #2B2D3B). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/w_radius" />
            <gradient
                android:angle="270"
                android:endColor="#FF2B2D3B"
                android:startColor="#FF3F4256"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/w_radius" />
            <gradient
                android:centerX="0"
                android:centerY="0"
                android:endColor="#00000000"
                android:gradientRadius="@dimen/w_glow_radius"
                android:startColor="#6B587AF5"
                android:type="radial" />
        </shape>
    </item>
</layer-list>

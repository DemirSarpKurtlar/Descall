<?xml version="1.0" encoding="utf-8"?>
<!-- Widget surface, Descall light (draft B light: #F7F8FF to #ECEFFB, accent glow). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/w_radius" />
            <gradient
                android:angle="270"
                android:endColor="#FFECEFFB"
                android:startColor="#FFF7F8FF"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/w_radius" />
            <gradient
                android:centerX="0"
                android:centerY="0"
                android:endColor="#00000000"
                android:gradientRadius="@dimen/w_glow_radius"
                android:startColor="#33587AF5"
                android:type="radial" />
        </shape>
    </item>
</layer-list>

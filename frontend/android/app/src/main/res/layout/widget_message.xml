<?xml version="1.0" encoding="utf-8"?>
<!-- Any widget without data to show: signed out ("Sign in"), or the first load failed ("Try again"). -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToOutline="true"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/w_header"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/w_logo"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_w_logo" />

            <TextView
                android:id="@+id/w_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:maxLines="1"
                android:textSize="12.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:gravity="center"
            android:layout_weight="1"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/w_empty_icon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_w_logo" />

            <TextView
                android:id="@+id/w_empty_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:includeFontPadding="false"
                android:layout_marginTop="8dp"
                android:maxLines="2"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/w_empty_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:includeFontPadding="false"
                android:layout_marginTop="3dp"
                android:maxLines="3"
                android:textSize="11.5sp" />

            <TextView
                android:id="@+id/w_empty_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/wbtn_accent"
                android:ellipsize="end"
                android:gravity="center"
                android:includeFontPadding="false"
                android:layout_marginTop="10dp"
                android:maxLines="1"
                android:paddingBottom="6dp"
                android:paddingEnd="14dp"
                android:paddingStart="14dp"
                android:paddingTop="6dp"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Friends widget, 4x2 (friends.m): "Online" header, four faces with name and what they are doing. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToOutline="true"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/w_header"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/w_logo"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_w_logo" />

            <TextView
                android:id="@+id/w_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:maxLines="1"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/w_stale_icon"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:importantForAccessibility="no"
                android:layout_marginEnd="3dp"
                android:src="@drawable/ic_w_offline"
                android:visibility="gone" />

            <TextView
                android:id="@+id/w_stale"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:layout_marginEnd="8dp"
                android:maxLines="1"
                android:textSize="10.5sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/w_meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/w_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/cell0"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:layout_weight="1"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/face0"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/name0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:layout_marginTop="6dp"
                    android:maxLines="1"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/act0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:layout_marginEnd="2dp"
                    android:layout_marginStart="2dp"
                    android:layout_marginTop="1dp"
                    android:maxLines="1"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cell1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:layout_weight="1"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/face1"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/name1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:layout_marginTop="6dp"
                    android:maxLines="1"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/act1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:layout_marginEnd="2dp"
                    android:layout_marginStart="2dp"
                    android:layout_marginTop="1dp"
                    android:maxLines="1"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cell2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:layout_weight="1"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/face2"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/name2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:layout_marginTop="6dp"
                    android:maxLines="1"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/act2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:layout_marginEnd="2dp"
                    android:layout_marginStart="2dp"
                    android:layout_marginTop="1dp"
                    android:maxLines="1"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cell3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:layout_weight="1"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/face3"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/name3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:layout_marginTop="6dp"
                    android:maxLines="1"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/act3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:layout_marginEnd="2dp"
                    android:layout_marginStart="2dp"
                    android:layout_marginTop="1dp"
                    android:maxLines="1"
                    android:textSize="10.5sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/w_empty_box"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:layout_marginTop="0dp"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:id="@+id/w_empty_icon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_w_users" />

            <TextView
                android:id="@+id/w_empty_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:includeFontPadding="false"
                android:layout_marginTop="8dp"
                android:maxLines="2"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/w_empty_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:includeFontPadding="false"
                android:layout_marginTop="3dp"
                android:maxLines="3"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/w_empty_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/wbtn_accent"
                android:ellipsize="end"
                android:gravity="center"
                android:includeFontPadding="false"
                android:layout_marginTop="10dp"
                android:maxLines="1"
                android:paddingBottom="6dp"
                android:paddingEnd="14dp"
                android:paddingStart="14dp"
                android:paddingTop="6dp"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

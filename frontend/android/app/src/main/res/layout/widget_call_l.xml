<?xml version="1.0" encoding="utf-8"?>
<!-- Call widget, 4x4 (call.l): the room and timer, call tiles (the one talking has a green edge), your mute, sound and leave. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToOutline="true"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/w_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/w_header"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/w_logo"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_w_logo" />

            <TextView
                android:id="@+id/cline1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:maxLines="1"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <Chronometer
                android:id="@+id/cchrono"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ctiles"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="11dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/ctilerow0"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/ctile0"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <ImageView
                        android:id="@+id/ctileface0"
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:importantForAccessibility="no"
                        android:layout_gravity="center" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/wlabel_tile"
                        android:gravity="center_vertical"
                        android:layout_gravity="bottom|start"
                        android:layout_margin="7dp"
                        android:orientation="horizontal"
                        android:paddingBottom="2dp"
                        android:paddingEnd="7dp"
                        android:paddingStart="7dp"
                        android:paddingTop="2dp">

                        <TextView
                            android:id="@+id/ctilename0"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:textColor="#FFFFFFFF"
                            android:textSize="11.5sp" />

                        <ImageView
                            android:id="@+id/ctileshare0"
                            android:layout_width="11dp"
                            android:layout_height="11dp"
                            android:importantForAccessibility="no"
                            android:layout_marginStart="4dp"
                            android:src="@drawable/ic_w_screen"
                            android:visibility="gone" />
                    </LinearLayout>
                </FrameLayout>

                <FrameLayout
                    android:layout_width="8dp"
                    android:layout_height="0dp" />

                <FrameLayout
                    android:id="@+id/ctile1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <ImageView
                        android:id="@+id/ctileface1"
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:importantForAccessibility="no"
                        android:layout_gravity="center" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/wlabel_tile"
                        android:gravity="center_vertical"
                        android:layout_gravity="bottom|start"
                        android:layout_margin="7dp"
                        android:orientation="horizontal"
                        android:paddingBottom="2dp"
                        android:paddingEnd="7dp"
                        android:paddingStart="7dp"
                        android:paddingTop="2dp">

                        <TextView
                            android:id="@+id/ctilename1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:textColor="#FFFFFFFF"
                            android:textSize="11.5sp" />

                        <ImageView
                            android:id="@+id/ctileshare1"
                            android:layout_width="11dp"
                            android:layout_height="11dp"
                            android:importantForAccessibility="no"
                            android:layout_marginStart="4dp"
                            android:src="@drawable/ic_w_screen"
                            android:visibility="gone" />
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="8dp" />

            <LinearLayout
                android:id="@+id/ctilerow1"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/ctile2"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <ImageView
                        android:id="@+id/ctileface2"
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:importantForAccessibility="no"
                        android:layout_gravity="center" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/wlabel_tile"
                        android:gravity="center_vertical"
                        android:layout_gravity="bottom|start"
                        android:layout_margin="7dp"
                        android:orientation="horizontal"
                        android:paddingBottom="2dp"
                        android:paddingEnd="7dp"
                        android:paddingStart="7dp"
                        android:paddingTop="2dp">

                        <TextView
                            android:id="@+id/ctilename2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:textColor="#FFFFFFFF"
                            android:textSize="11.5sp" />

                        <ImageView
                            android:id="@+id/ctileshare2"
                            android:layout_width="11dp"
                            android:layout_height="11dp"
                            android:importantForAccessibility="no"
                            android:layout_marginStart="4dp"
                            android:src="@drawable/ic_w_screen"
                            android:visibility="gone" />
                    </LinearLayout>
                </FrameLayout>

                <FrameLayout
                    android:layout_width="8dp"
                    android:layout_height="0dp" />

                <FrameLayout
                    android:id="@+id/ctile3"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <ImageView
                        android:id="@+id/ctileface3"
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:importantForAccessibility="no"
                        android:layout_gravity="center" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/wlabel_tile"
                        android:gravity="center_vertical"
                        android:layout_gravity="bottom|start"
                        android:layout_margin="7dp"
                        android:orientation="horizontal"
                        android:paddingBottom="2dp"
                        android:paddingEnd="7dp"
                        android:paddingStart="7dp"
                        android:paddingTop="2dp">

                        <TextView
                            android:id="@+id/ctilename3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:textColor="#FFFFFFFF"
                            android:textSize="11.5sp" />

                        <ImageView
                            android:id="@+id/ctileshare3"
                            android:layout_width="11dp"
                            android:layout_height="11dp"
                            android:importantForAccessibility="no"
                            android:layout_marginStart="4dp"
                            android:src="@drawable/ic_w_screen"
                            android:visibility="gone" />
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/cme"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/cmeline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:maxLines="1"
                android:textSize="11.5sp" />

            <FrameLayout
                android:id="@+id/cmute"
                android:layout_width="40dp"
                android:layout_height="34dp"
                android:background="@drawable/wpill_dark"
                android:importantForAccessibility="yes">

                <ImageView
                    android:id="@+id/cmute_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:importantForAccessibility="no"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_w_mic" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="8dp"
                android:layout_height="0dp" />

            <FrameLayout
                android:id="@+id/cdeafen"
                android:layout_width="40dp"
                android:layout_height="34dp"
                android:background="@drawable/wpill_dark"
                android:importantForAccessibility="yes">

                <ImageView
                    android:id="@+id/cdeafen_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:importantForAccessibility="no"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_w_headphones" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="8dp"
                android:layout_height="0dp" />

            <FrameLayout
                android:id="@+id/cleave"
                android:layout_width="52dp"
                android:layout_height="34dp"
                android:background="@drawable/wbtn_danger"
                android:importantForAccessibility="yes">

                <ImageView
                    android:id="@+id/cleave_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:importantForAccessibility="no"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_w_leave" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/w_idle"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:id="@+id/w_idle_face"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/w_idle_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:includeFontPadding="false"
            android:layout_marginTop="10dp"
            android:maxLines="1"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_idle_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:includeFontPadding="false"
            android:layout_marginTop="3dp"
            android:maxLines="2"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/w_idle_join"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingEnd="11dp"
                android:paddingStart="11dp">

                <ImageView
                    android:id="@+id/w_idle_join_icon"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_w_join" />

                <TextView
                    android:id="@+id/w_idle_join_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:layout_marginStart="4dp"
                    android:maxLines="1"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

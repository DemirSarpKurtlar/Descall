<?xml version="1.0" encoding="utf-8"?>
<!-- Voice widget, 2x2 (voice.s): the busiest room as a cluster of faces, one tap Join. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToOutline="true"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/w_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/vserver0"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/vservername0"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:maxLines="1"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/vroom0"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginTop="9dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/vcluster0"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/vname0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="2"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/vsub0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:layout_marginTop="1dp"
                    android:maxLines="1"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/w_more"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:layout_weight="1"
                android:maxLines="1"
                android:textSize="10.5sp" />

            <LinearLayout
                android:id="@+id/vjoin0"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingEnd="11dp"
                android:paddingStart="11dp">

                <ImageView
                    android:id="@+id/vjoin0_icon"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_w_join" />

                <TextView
                    android:id="@+id/vjoin0_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:layout_marginStart="4dp"
                    android:maxLines="1"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/vhere0"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:background="@drawable/wbtn_here"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingEnd="10dp"
                android:paddingStart="10dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/vhere0_icon"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_w_wave" />

                <TextView
                    android:id="@+id/vhere0_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:layout_marginStart="4dp"
                    android:maxLines="1"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:layout_gravity="top|end"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/w_stale_icon"
            android:layout_width="11dp"
            android:layout_height="11dp"
            android:importantForAccessibility="no"
            android:layout_marginEnd="3dp"
            android:src="@drawable/ic_w_offline"
            android:visibility="gone" />

        <TextView
            android:id="@+id/w_stale"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textSize="10sp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/w_empty_box"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:layout_marginTop="0dp"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:id="@+id/w_empty_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_w_wave" />

        <TextView
            android:id="@+id/w_empty_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:includeFontPadding="false"
            android:layout_marginTop="8dp"
            android:maxLines="2"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/w_empty_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:includeFontPadding="false"
            android:layout_marginTop="3dp"
            android:maxLines="3"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/w_empty_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/wbtn_accent"
            android:ellipsize="end"
            android:gravity="center"
            android:includeFontPadding="false"
            android:layout_marginTop="10dp"
            android:maxLines="1"
            android:paddingBottom="6dp"
            android:paddingEnd="14dp"
            android:paddingStart="14dp"
            android:paddingTop="6dp"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>

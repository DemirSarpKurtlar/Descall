<?xml version="1.0" encoding="utf-8"?>
<!-- Widget settings (draft B "Favori yuzler"): live preview, pick and order up to 8 faces,
     activity line and wave button switches, colour (Descall dark / light / dynamic), the
     voice widget's servers. WidgetConfigActivity.java fills it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cfg_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/wcfg_bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <Button
            android:id="@+id/cfg_cancel"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAllCaps="false"
            android:textColor="@color/wcfg_accent"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/cfg_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/wcfg_text"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/cfg_done"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAllCaps="false"
            android:textColor="@color/wcfg_accent"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/cfg_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:id="@+id/cfg_preview_label"
                style="@style/WidgetConfigHeader" />

            <FrameLayout
                android:id="@+id/cfg_preview_stage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/wcfg_preview"
                android:padding="16dp">

                <FrameLayout
                    android:id="@+id/cfg_preview_host"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center" />

                <!-- Taps on the preview do nothing (its buttons are real PendingIntents). -->
                <FrameLayout
                    android:id="@+id/cfg_preview_shield"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clickable="true"
                    android:focusable="false"
                    android:importantForAccessibility="no" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/cfg_faces_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/cfg_faces_label"
                    style="@style/WidgetConfigHeader" />

                <LinearLayout
                    android:id="@+id/cfg_faces"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/wcfg_group"
                    android:minHeight="96dp"
                    android:orientation="vertical"
                    android:padding="10dp" />

                <TextView
                    android:id="@+id/cfg_faces_note"
                    style="@style/WidgetConfigFooter" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cfg_status_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="8dp"
                android:visibility="gone">

                <ProgressBar
                    android:id="@+id/cfg_progress"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:id="@+id/cfg_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/wcfg_text2"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/cfg_status_action"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAllCaps="false"
                    android:textColor="@color/wcfg_accent" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cfg_toggles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/wcfg_group"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/cfg_activity_row"
                    style="@style/WidgetConfigRow">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/cfg_activity_title"
                            style="@style/WidgetConfigRowTitle" />

                        <TextView
                            android:id="@+id/cfg_activity_sub"
                            style="@style/WidgetConfigRowSub" />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/cfg_activity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="1px"
                    android:layout_marginStart="16dp"
                    android:background="@color/wcfg_line" />

                <LinearLayout
                    android:id="@+id/cfg_wave_row"
                    style="@style/WidgetConfigRow">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/cfg_wave_title"
                            style="@style/WidgetConfigRowTitle" />

                        <TextView
                            android:id="@+id/cfg_wave_sub"
                            style="@style/WidgetConfigRowSub" />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/cfg_wave"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cfg_servers_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/cfg_servers_label"
                    style="@style/WidgetConfigHeader" />

                <LinearLayout
                    android:id="@+id/cfg_servers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/wcfg_group"
                    android:orientation="vertical"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp" />

                <TextView
                    android:id="@+id/cfg_servers_note"
                    style="@style/WidgetConfigFooter" />
            </LinearLayout>

            <TextView
                android:id="@+id/cfg_color_label"
                style="@style/WidgetConfigHeader" />

            <RadioGroup
                android:id="@+id/cfg_color"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/wcfg_group"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="4dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp">

                <RadioButton
                    android:id="@+id/cfg_color_dark"
                    style="@style/WidgetConfigRadio" />

                <RadioButton
                    android:id="@+id/cfg_color_light"
                    style="@style/WidgetConfigRadio" />

                <RadioButton
                    android:id="@+id/cfg_color_dynamic"
                    style="@style/WidgetConfigRadio" />
            </RadioGroup>

            <TextView
                android:id="@+id/cfg_color_note"
                style="@style/WidgetConfigFooter" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>

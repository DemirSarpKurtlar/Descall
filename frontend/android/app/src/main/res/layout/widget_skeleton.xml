<?xml version="1.0" encoding="utf-8"?>
<!-- First load (no cached data yet): grey faces and lines in the widget's colours. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToOutline="true"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/w_logo"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_w_logo" />

            <ImageView
                android:id="@+id/sk_title"
                android:layout_width="90dp"
                android:layout_height="10dp"
                android:importantForAccessibility="no"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:layout_weight="1"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/sk_face0"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:importantForAccessibility="no" />

                <ImageView
                    android:id="@+id/sk_line0"
                    android:layout_width="36dp"
                    android:layout_height="8dp"
                    android:importantForAccessibility="no"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:layout_weight="1"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/sk_face1"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:importantForAccessibility="no" />

                <ImageView
                    android:id="@+id/sk_line1"
                    android:layout_width="36dp"
                    android:layout_height="8dp"
                    android:importantForAccessibility="no"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:layout_weight="1"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/sk_face2"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:importantForAccessibility="no" />

                <ImageView
                    android:id="@+id/sk_line2"
                    android:layout_width="36dp"
                    android:layout_height="8dp"
                    android:importantForAccessibility="no"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:layout_weight="1"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/sk_face3"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:importantForAccessibility="no" />

                <ImageView
                    android:id="@+id/sk_line3"
                    android:layout_width="36dp"
                    android:layout_height="8dp"
                    android:importantForAccessibility="no"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Unread widget, 2x2 (unread.s): the latest sender's face with the count, the message as a bubble. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToOutline="true"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/w_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/uav0"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/utitle0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/utime0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:textSize="11sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/w_logo"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:importantForAccessibility="no"
                android:layout_gravity="top"
                android:src="@drawable/ic_w_logo" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ububble0"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:paddingBottom="7dp"
            android:paddingEnd="10dp"
            android:paddingStart="10dp"
            android:paddingTop="7dp">

            <TextView
                android:id="@+id/uprev0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:lineSpacingExtra="1dp"
                android:maxLines="3"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:layout_gravity="top|end"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/w_stale_icon"
            android:layout_width="11dp"
            android:layout_height="11dp"
            android:importantForAccessibility="no"
            android:layout_marginEnd="3dp"
            android:src="@drawable/ic_w_offline"
            android:visibility="gone" />

        <TextView
            android:id="@+id/w_stale"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textSize="10sp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/w_empty_box"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:layout_marginTop="0dp"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:id="@+id/w_empty_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_w_msg" />

        <TextView
            android:id="@+id/w_empty_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:includeFontPadding="false"
            android:layout_marginTop="8dp"
            android:maxLines="2"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/w_empty_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:includeFontPadding="false"
            android:layout_marginTop="3dp"
            android:maxLines="3"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/w_empty_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/wbtn_accent"
            android:ellipsize="end"
            android:gravity="center"
            android:includeFontPadding="false"
            android:layout_marginTop="10dp"
            android:maxLines="1"
            android:paddingBottom="6dp"
            android:paddingEnd="14dp"
            android:paddingStart="14dp"
            android:paddingTop="6dp"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>

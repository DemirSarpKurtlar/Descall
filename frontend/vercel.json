{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "ELECTRON_SKIP_BINARY_DOWNLOAD=1 npm install --include=dev",
  "buildCommand": "npm run build:prod",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.descall.com"
        }
      ],
      "destination": "https://descall.com/:path*",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "descall.com"
        },
        {
          "type": "header",
          "key": "x-forwarded-proto",
          "value": "http"
        }
      ],
      "destination": "https://descall.com/:path*",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.descall.com"
        },
        {
          "type": "header",
          "key": "x-forwarded-proto",
          "value": "http"
        }
      ],
      "destination": "https://descall.com/:path*",
      "statusCode": 301
    },
    {
      "source": "/tr/discord-alternative",
      "destination": "/tr/discord-alternatifi",
      "statusCode": 301
    },
    {
      "source": "/discord-alternative-turkey",
      "destination": "/tr/discord-alternatifi",
      "statusCode": 301
    },
    {
      "source": "/tr/contact",
      "destination": "/iletisim",
      "statusCode": 301
    },
    {
      "source": "/founder",
      "destination": "/who-owns-descall",
      "statusCode": 301
    },
    {
      "source": "/owner",
      "destination": "/who-owns-descall",
      "statusCode": 301
    },
    {
      "source": "/kurucu",
      "destination": "/descall-sahibi",
      "statusCode": 301
    },
    {
      "source": "/sahip",
      "destination": "/descall-sahibi",
      "statusCode": 301
    },
    {
      "source": "/tr/who-owns-descall",
      "destination": "/descall-sahibi",
      "statusCode": 301
    },
    {
      "source": "/dimaai",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/dimaai/:path*",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "statusCode": 301
    },
    {
      "source": "/lfg",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/lfg/:path*",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/valorant",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/valorant/:path*",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/riot",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/riot/:path*",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/play",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/play/:path*",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/discord-alternative-for-lfg",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/blog/best-discord-alternative-for-lfg",
      "destination": "/",
      "statusCode": 301
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://des-call.onrender.com/api/:path*"
    },
    {
      "source": "/direct",
      "destination": "/index.html"
    },
    {
      "source": "/direct/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/groups",
      "destination": "/index.html"
    },
    {
      "source": "/groups/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/servers",
      "destination": "/index.html"
    },
    {
      "source": "/servers/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/friends",
      "destination": "/index.html"
    },
    {
      "source": "/friends/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/calls",
      "destination": "/index.html"
    },
    {
      "source": "/calls/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/activity",
      "destination": "/index.html"
    },
    {
      "source": "/activity/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/settings",
      "destination": "/index.html"
    },
    {
      "source": "/settings/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/invite",
      "destination": "/index.html"
    },
    {
      "source": "/invite/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/app",
      "destination": "/index.html"
    },
    {
      "source": "/app/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/login",
      "destination": "/index.html"
    },
    {
      "source": "/login/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/register",
      "destination": "/index.html"
    },
    {
      "source": "/register/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/tr/login",
      "destination": "/index.html"
    },
    {
      "source": "/tr/login/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/tr/register",
      "destination": "/index.html"
    },
    {
      "source": "/tr/register/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/i",
      "destination": "/index.html"
    },
    {
      "source": "/i/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/s",
      "destination": "/index.html"
    },
    {
      "source": "/s/:path*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/favicon.ico",
      "headers": [
        {
          "key": "Content-Type",
          "value": "image/x-icon"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/favicon.svg",
      "headers": [
        {
          "key": "Content-Type",
          "value": "image/svg+xml"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/(favicon-32.png|favicon-48.png|favicon-96.png|favicon-144.png|favicon-192.png|favicon-512.png|apple-touch-icon.png|icon-16.png|icon-32.png|icon-192.png|icon-512.png|icon-512-maskable.png|icon.png)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "image/png"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(js|css|woff2|wasm)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(png|jpg|jpeg|webp|avif|svg|ico|gif)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(llms.txt|llms-full.txt|humans.txt)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=600"
        },
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        },
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    },
    {
      "source": "/.well-known/security.txt",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        },
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/(sitemap.xml|sitemap-pages.xml|sitemap-core.xml|sitemap-niches.xml|sitemap-blog.xml|sitemap-company.xml|robots.txt)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=600"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/:key([a-f0-9]{32}).txt",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        },
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/sitemap.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=600"
        },
        {
          "key": "Content-Type",
          "value": "text/html; charset=utf-8"
        }
      ]
    },
    {
      "source": "/sitemap.xsl",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        },
        {
          "key": "Content-Type",
          "value": "application/xslt+xml; charset=utf-8"
        }
      ]
    },
    {
      "source": "/(features|faq|download|discord-alternative|alternatives|compare|about|who-owns-descall|descall-sahibi|security|status|privacy|terms|contact|blog|tr)(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=120, s-maxage=600, stale-while-revalidate=86400"
        },
        {
          "key": "X-Descall-Shell",
          "value": "marketing"
        }
      ]
    },
    {
      "source": "/((?!assets/).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60, s-maxage=300, stale-while-revalidate=600"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(self), display-capture=(self), autoplay=(self)"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'sha256-S6HfTfHplG8p60gFprOJ2yF+7QjQiqcjT622MJIGsUc=' 'sha256-8DfRHI8tBT7aebwoSE1O7M5Eyi53vXPaVkKg6Ts+tXs=' 'sha256-KaoFSX3TCKiHgad1CVsr8xoDclCAffaQrQtErU7iRqc=' 'sha256-55Lg65UfHgpMWGmpdWaAw1ij+9uyiGVYnh+XvLULkP0=' 'sha256-yBF1MUju54iRuL/fti/cWyhku2cnv6Ff2scoFZLOa3c=' 'sha256-8O6fXtGVKTVzWNUD8da/uLiptJqxgFDfLe0FJkarXGw=' 'sha256-eSNFUNqALkZczatvPjUNWi4Zl3/adLqQoBwvL1fvHqo=' 'sha256-A7qOjqZid/Tryt1SZfUpAJHTQ+3lnkzTeKZ1JlwBSCk=' 'sha256-X6IZooTuD0j+iwfFoTuhClPTwrmMH0sIGqTJHDEEl8Q=' 'sha256-/Klya6xNTxAqERBzgqp2O3T0Na/gBdvbu0OUya8IKUw=' 'sha256-ZCBl+yGvdB6zsSMVoAoZBn41QaO8LSqBKEJlxUEoj8A=' 'sha256-uTUWQ7h7HJ1YJi/9oCc8AwDTUAvj+dsZ7s0p5cNMUcs=' https://eu-assets.i.posthog.com https://www.googletagmanager.com https://www.google-analytics.com https://www.googleadservices.com https://accounts.google.com https://www.clarity.ms https://*.clarity.ms https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://descall.com https://www.descall.com https://des-call.onrender.com https://api.descall.com https://*.supabase.co https://*.supabase.in https://*.giphy.com https://*.tenor.com https://*.gstatic.com https://www.google-analytics.com https://www.googletagmanager.com https://*.githubusercontent.com https://*.googleusercontent.com https://*.clarity.ms; media-src 'self' blob: data: https://descall.com https://des-call.onrender.com https://api.descall.com https://*.supabase.co https://*.giphy.com https://*.tenor.com; connect-src 'self' https://descall.com https://www.descall.com https://des-call.onrender.com wss://des-call.onrender.com https://api.descall.com wss://rt.descall.com https://*.supabase.co wss://*.supabase.co https://*.supabase.in wss://*.supabase.in https://api.giphy.com https://*.g
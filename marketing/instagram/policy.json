{
  "$comment": "Guardrails for every Reel. The validator (lib/validator.mjs) enforces all of this before anything is rendered or posted. Phrases are matched case-insensitively (Turkish and plain lowercase) at a word start; a trailing * also matches suffixes (kötü* matches kötüdür). The retired game product terms (removed from the app in 2.13.0) are built in code (lib/validator.mjs RETIRED_TERMS) so this file never names them.",
  "themes": {
    "discord-tasima": "Topluluğunu Discord'dan taşımak (olgusal, kötüleme yok, Discord logosu yok)",
    "ses-kalitesi": "Ses kalitesi ve gürültü engelleme",
    "ekran-paylasimi": "Ekran paylaşımı",
    "sunucular-roller": "Sunucular, kanallar ve roller",
    "platformlar": "iPhone, Windows ve web",
    "ucretsiz": "Ücretsiz özellikler",
    "descall-plus": "Descall+ ayrıcalıkları",
    "oyun": "Oyuncular için (Minecraft, CS2 ve diğerleri)",
    "ders-grubu": "Ders ve çalışma grupları",
    "ipuclari": "İpuçları ve kısayollar",
    "surum-notlari": "Sürüm notlarından öne çıkanlar"
  },
  "limits": {
    "minDurationSec": 10,
    "maxDurationSec": 30,
    "maxHookSec": 2.5,
    "minScenes": 3,
    "maxScenes": 6,
    "maxWordsPerLine": 7,
    "maxCharsPerLine": 34,
    "maxLinesPerBlock": 3,
    "maxHookLines": 2,
    "maxVisualItems": 6,
    "maxWordsPerVisualItem": 4,
    "maxCaptionChars": 2200,
    "minHashtags": 3,
    "maxHashtags": 8,
    "duplicateWindow": 30
  },
  "ctaMustContain": "descall.com",

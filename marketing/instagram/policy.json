        "kusursuz*",
        "mükemmel*",
        "garanti*",
        "%100",
        "yüzde yüz",
        "sıfır gecikme*",
        "gecikmesiz*",
        "hiç kopma*",
        "hiç donma*",
        "kesintisiz*",
        "sınırsız*",
        "limitsiz*",
        "reklamsız*",
        "uçtan uca*",
        "daha iyi*",
        "daha hızlı*",

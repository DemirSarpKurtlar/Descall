    {
      "reason": "legal or access topics we do not make claims about",
      "phrases": [
        "vpn",
        "engellendi*",
        "erişim engel*",
        "yasaklandı*",
        "yasağı*",
        "yasaklı*",
        "kapatıldı*",
        "açıldı mı*",
        "mahkeme*",
        "dns"
      ]
    },
    {
      "reason": "competitor product names and pricing talk (Descall+ has no public purchase yet)",
      "phrases": [
        "nitro*",
        "satın al*",
        "abone ol*",
        "fiyat*",
        "indirim*",
        "kampanya*",
        "ödeme*",
        "lira*",
        "tl",
        "₺",
        "dolar*",
        "$"
      ]
    },
    {
      "reason": "not confirmed as publicly shipped on the App Store",
      "phrases": [
        "apple watch*",
        "saat uygulama*",
        "testflight*"
      ]
    }
  ],
  "restrictedPhrases": [
    {
      "reason": "Discord is named only in the factual moving theme",
      "phrases": [
        "discord*"
      ],
      "onlyThemes": [
        "discord-tasima"
      ]
    },
    {
      "reason": "release highlights ship to Windows and web first; the App Store build may lag",
      "phrases": [
        "iphone*",
        "ipad*",
        "app store*",
        "ios"
      ],
      "notThemes": [
        "surum-notlari",
        "descall-plus"
      ]
    }
  ],
  "screenshotAllowlist": "screenshots.json",
  "sourceRoots": [
    "frontend/src",
    "frontend/backend",
    "frontend/electron",
    "frontend/ios",
    "appstore",
    "docs/release-notes"
  ]
}
